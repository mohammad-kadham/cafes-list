<!DOCTYPE html>
<html>
<head>
  <title>Rate <%= cafe.title %></title>
</head>
<body>

  <a href="/cafes">&larr; Back to all cafes</a>

  <h2>Rate <%= cafe.title %></h2>



  <form method="POST" action="/rate">
    <label for="wifi">rate wifi speed:</label>
    <select name="wifi" id="wifi" required>
      <option value="1">bad</option>
      <option value="2">okay</option>
      <option value="3">good</option>
    </select>
     <label for="outlet">rate outlet avaliblity:</label>
    <select name="outlet" id="outlet" required>
      <option value="1">low</option>
      <option value="2">mid</option>
      <option value="3">high</option>
    </select>
     <label for="seat">rate seats comfort:</label>
    <select name="seat" id="seat" required>
      <option value="1">bad</option>
      <option value="2">mid</option>
      <option value="3">comfy</option>
    </select>
     <label for="seat">rate the Service:</label>
    <select name="service" id="service" required>
      <option value="1">bad</option>
      <option value="2">mid</option>
      <option value="3">good</option>
    </select>
     <label for="seat">rate the noise level:</label>
    <select name="noise" id="noise" required>
      <option value="1">high</option>
      <option value="2">mid</option>
      <option value="3">low</option>
    </select>
     <label for="seat">rate the prices:</label>
    <select name="price" id="price" required>
      <option value="1">expensive</option>
      <option value="2">normal</option>
      <option value="3">cheap</option>
    </select>
<input type="hidden" name="cafe_id" value=<%-cafe.id%>>

    <button type="submit">Submit Rating</button>
    <input type="hidden" name="_csrf" value=<%=ss%>>
  </form>

</body>
</html>