<%- include('../partials/header') %>

    <body>
        <%-include('../partials/navigation')%>

        <main>
            <section class="explainer">
    <div class="explainer__intro">
        <p class="eyebrow">What is Cafeslist</p>
        <h2>Not another coffee review site.</h2>
        <p class="explainer__lede">Star ratings tell you if the coffee's good. They don't tell you if you can actually get work done there. So we built something that does.</p>
    </div>

    <div class="explainer__grid">
        <div class="explainer__item">
            <div class="explainer__icon">1</div>
            <h3>Rated on what matters for work</h3>
            <p>Wifi speed, outlet count, seat comfort, noise level, service, and price — six dimensions, not one vague star rating.</p>
        </div>

        <div class="explainer__item">
            <div class="explainer__icon">2</div>
            <h3>Rated by people who stayed</h3>
            <p>Every score comes from someone who actually sat down and worked — not a drive-by review of the espresso.</p>
        </div>

        <div class="explainer__item">
            <div class="explainer__icon">3</div>
            <h3>Checked before it's listed</h3>
            <p>New cafes go through a quick approval step before they show up, so the list stays real, not spammy.</p>
        </div>
    </div>
</section>
            <form class="sort-form" method="GET" action="/cafes/filter">
                <label>Highest rated cafe with:
                    <select name="sort">
                        <option <% if (sortQuery==='avgWifiSpeed' ) { %>selected<% } %> value="avgWifiSpeed">best wifi speed</option>
                        <option <% if (sortQuery==='avgOutletCount' ) { %>selected<% } %> value="avgOutletCount">high power outlets count</option>
                        <option <% if (sortQuery==='avgSeatComfort' ) { %>selected<% } %> value="avgSeatComfort">best seats</option>
                        <option <% if (sortQuery==='avgService' ) { %>selected<% } %> value="avgService">best service</option>
                        <option <% if (sortQuery==='avgNoiseLevel' ) { %>selected<% } %> value="avgNoiseLevel">lowest noise level</option>
                        <option <% if (sortQuery==='avgPrices' ) { %>selected<% } %> value="avgPrices">cheap prices</option>
                    </select>
                </label>
                <button class="btn" type="submit">Apply Filters</button>
            </form>

            <div class="container">
                <% if (cafes.length > 0) { %>
                    <% cafes.forEach((cafe, index) => { %>
                        <div class="card">
                            <div class="card__img-frame">
                                <img src="<%-cafe.imageUrl%>" alt="" class="card__img">
                                <div class="card__badge"><%-cafe.avgRating%></div>
                            </div>

                            <div class="card__body">
                                <h1 class="card__title"><%-cafe.title%></h1>
                                <p class="card__location"><%-cafe.location%></p>
                                <p class="card__city"><%-cafe.city%></p>

                                <div class="card__meta-row">
                                    <span><%-cafe.openingHours%></span>
                                    <span><%-cafe.ratingCount%> ratings</span>
                                </div>
                            </div>

                            <div class="card__overlay">
                                <a href=<%-`/rate/${cafe.id}`%> class="btn btn--secondary">rate</a>
                                <a href=<%-`/details/${cafe.id}`%> class="btn btn--ghost">detail</a>
                                <p class="card__location">📍 <%-cafe.location%></p>
                                <p class="card__city"><%-cafe.city%></p>
                                <div class="rating-strip">
                                    <progress class="rating-strip__bar" max="5" value="<%-cafe.avgRating%>"></progress>
                                    <p class="card__city">overall rating <%-cafe.avgRating%></p>
                                </div>
                                <p class="card__city">people <%-cafe.ratingCount%></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <h1>no cafes in your selected city</h1>
                <% } %>
            </div>
        </main>
    </body>

    <%-include('../partials/footer')%>
