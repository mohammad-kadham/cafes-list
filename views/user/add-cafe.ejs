<%-include('../partials/header')%>

    <body>
        <div class="form-page">
            <form class="form" action="/cafes/add" method="post" enctype="multipart/form-data">
                <h1 class="form__title">Add a Cafe</h1>

                <% if (err) { %>
                    <div class="form__error"><%-err%></div>
                <% } %>

                <div class="form__form-group">
                    <input class="form__input" type="text" name="title" placeholder="cafe's name">
                    <label class="form__label" for="">title</label>
                </div>

                <div class="form__form-group">
                    <input class="form__input" type="text" name="location" placeholder="street address">
                    <label class="form__label" for="">location</label>
                </div>

                <div class="form__form-group">
                    <input class="form__input" type="text" name="city" placeholder="city">
                    <label class="form__label" for="">city</label>
                </div>

                <div class="form__form-group">
                    <input class="form__input" type="text" name="openingHours" placeholder="e.g. 08:00 - 20:00">
                    <label class="form__label" for="">opening hours</label>
                </div>

                <input type="hidden" name="_csrf" value="<%=ss%>">

                <div class="form__form-group">
                    <input class="form__file" type="file" name="image" id="">
                    <label class="form__label" for="">cafe's picture</label>
                </div>

                <div class="form__form-group">
                    <button class="form__btn" type="submit">submit</button>
                </div>
            </form>
        </div>
    </body>

    </html>
