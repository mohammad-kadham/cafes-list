<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/assets/favicon.png" type="image/x-icon">
    <title>Something Went Wrong</title>
</head>
<body>
    <div class="error-page">
        <div class="error-page__box">
            <img src="/assets/404.svg" width="200" alt="">
            <p class="error-page__code">500</p>
            <h1 class="error-page__title">Something went wrong</h1>
            <p class="error-page__text">An unexpected error occurred on our end. Please try again in a moment.</p>
            <a href="/" class="btn">Home</a>
        </div>
    </div>
</body>
</html>
